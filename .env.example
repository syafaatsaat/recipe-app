# Copy to .env.local. These are the Supabase CLI's local defaults (`npx supabase status`),
# the same on every machine and useless outside localhost. Never put hosted keys here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Direct Postgres for Drizzle (server only). Hosted: use the transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Bearer secret for /api/keep-alive (Vercel Cron sends it). Any long random string locally.
CRON_SECRET=local-dev-cron-secret
# Optional: the Claude Haiku import fallback (doc §3.11). Leave empty to keep it off. Never commit a real key.
ANTHROPIC_API_KEY=
